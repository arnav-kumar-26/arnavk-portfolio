---
import Eyebrow from '../ui/Eyebrow.astro';
---

<section id="about" aria-labelledby="about-heading" class="py-section">
  <div class="about-grid">
    <div class="about-label">
      <Eyebrow label="INTRO" />
    </div>
    <div class="about-content space-y-4">
      <h2 id="about-heading" class="reveal font-display text-h2 tracking-tightest">Introduction</h2>
      <p class="reveal font-display text-body text-text-muted" style="animation-delay: calc(var(--stagger) * 1)">
        I'm Arnav — a developer focused on static-first, token-disciplined interfaces. I ship accessible Astro sites with zero-JS defaults, live GitHub stats as a narrow client exception, and Cloudflare Pages deploys that stay fast on the edge.
      </p>
      <p class="reveal font-display text-body text-text-muted" style="animation-delay: calc(var(--stagger) * 2)">
        Current focus: FastAPI + Astro + Expo monorepos (Mira Coach — resume builder & AI coach), fleet tracking dashboards, and design systems that enforce motion and layout tokens instead of hard-coded values.
      </p>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: var(--label-col-width) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .about-content {
    max-width: var(--content-col-max);
  }
  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
