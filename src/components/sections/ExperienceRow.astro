---
import type { ExperienceEntry } from '@/types';

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props as Props;
const dateRange = entry.endDate === 'present' ? `${entry.startDate} — present` : `${entry.startDate} — ${entry.endDate}`;
---

<div class="exp-row grid gap-12 py-10 border-b border-border-hairline pl-[4vw]">
  <div class="exp-label">
    <span class="font-mono text-body uppercase tracking-widest text-text-primary">{dateRange}</span>
    {entry.location && <span class="font-mono text-body text-text-muted block mt-2 leading-relaxed">{entry.location}</span>}
  </div>
  <h3 class="font-display text-h3">{entry.company} — {entry.role}</h3>
  <ul class="list-disc list-inside space-y-2 font-display text-body text-text-brown" role="list">
    {entry.impactBullets.map((b) => <li>{b}</li>)}
  </ul>
</div>

<style>
  .exp-row {
    grid-template-columns: minmax(12rem, 1.2fr) minmax(0, 1.5fr) minmax(0, 2fr);
  }
  @media (max-width: 640px) {
    .exp-row {
      grid-template-columns: 1fr;
    }
  }
</style>
