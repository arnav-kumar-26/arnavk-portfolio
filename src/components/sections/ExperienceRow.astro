---
import type { ExperienceEntry } from '@/types';

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props as Props;
const dateRange = entry.endDate === 'present' ? `${entry.startDate} — present` : `${entry.startDate} — ${entry.endDate}`;
---

<div class="exp-row flex flex-col md:grid md:grid-cols-8 md:gap-6 pt-0 pb-14 md:pt-0 md:pb-20 border-b border-border-hairline transition-colors duration-350 ease-signature hover:bg-neutral-100/30">
  <!-- Date & Location: strictly inside Column 2 -->
  <div class="md:col-start-2 md:col-span-1 md:row-start-1 md:row-span-2 mb-6 md:mb-0 p-2">
    <span class="font-mono text-[18.8px] uppercase tracking-widest text-text-primary block">{dateRange}</span>
    {entry.location && <span class="font-mono text-[18.8px] uppercase tracking-wider text-text-muted block mt-2">{entry.location}</span>}
  </div>

  <!-- Job Title: spans across Columns 3 to 7 -->
  <div class="md:col-start-3 md:col-span-5 md:row-start-1 mb-6 md:mb-8 p-2">
    <h3 class="font-display font-medium text-[36px] text-text-primary tracking-tight leading-tight">{entry.company} — {entry.role}</h3>
  </div>

  <!-- Bullet Points: positioned vertically below job title, spanning Columns 4 to 7 -->
  <div class="md:col-start-4 md:col-span-4 md:row-start-2 p-2">
    <ul class="list-disc list-outside space-y-4 pl-5 font-display text-[23.04px] leading-[1.6] text-[#1e1e1f]" role="list">
      {entry.impactBullets.map((b) => <li class="pl-1">{b}</li>)}
    </ul>
  </div>
</div>
