---
import type { Project } from '@/types';
import { Image } from 'astro:assets';
import miraCover from '../../assets/mira-coach-cover.png';
import fleetCover from '../../assets/fleet-tracker-cover.png';

interface Props {
  project: Project;
}

const { project } = Astro.props as Props;

const coverMap: Record<string, typeof miraCover> = {
  'mira-coach-cover.png': miraCover,
  'fleet-tracker-cover.png': fleetCover,
};

const cover = coverMap[project.coverImage] ?? miraCover;
---

<article class="project-card border border-border-hairline bg-background p-6 md:p-8 flex flex-col justify-between">
  <div>
    <div class="relative">
      <div class="layer-back absolute inset-0 translate-x-2 translate-y-2 bg-accent"></div>
      <div class="layer-front relative bg-background overflow-hidden aspect-[16/9] max-h-[360px] w-full border border-border-hairline">
        <Image src={cover} alt={`${project.title} cover`} width={800} height={450} loading="lazy" class="h-full w-full object-cover object-center" />
      </div>
    </div>
    <div class="pt-8 space-y-4">
      <h3 class="font-display font-medium text-2xl md:text-3xl text-text-primary tracking-tight">{project.title}</h3>
      <p class="font-display text-[23.04px] leading-[1.5] text-[#1e1e1f]">{project.summary}</p>
      <p class="font-display text-[23.04px] leading-[1.6] text-[#1e1e1f]">{project.description}</p>
    </div>
  </div>
  <div class="pt-6 space-y-4">
    <div class="flex flex-wrap gap-2.5 pt-2">
      {project.tags.map((t) => (
        <span class="inline-flex items-center rounded-button border border-border-hairline px-3.5 py-1.5 font-mono text-[15px] uppercase tracking-wider text-text-primary bg-background transition-colors duration-350 ease-signature hover:border-text-primary">{t}</span>
      ))}
    </div>
    {project.demoUrl && (
      <iframe
        src={project.demoUrl}
        title={`${project.title} demo`}
        loading="lazy"
        class="mt-4 h-72 w-full border border-border-hairline"
        sandbox="allow-scripts allow-same-origin"
      ></iframe>
    )}
    <div class="pt-2">
      <span class="font-mono text-[15px] uppercase tracking-widest text-text-muted">{project.status}</span>
    </div>
  </div>
</article>
