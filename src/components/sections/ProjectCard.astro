---
import type { Project } from '@/types';
import { Image } from 'astro:assets';
import miraCover from '../../assets/mira-coach-cover.png';
import fleetCover from '../../assets/fleet-tracker-cover.png';

interface Props {
  project: Project;
}

const { project } = Astro.props as Props;

const coverMap: Record<string, typeof miraCover> = {
  'mira-coach-cover.png': miraCover,
  'fleet-tracker-cover.png': fleetCover,
};

const cover = coverMap[project.coverImage] ?? miraCover;
---

<article class="project-card border border-border-hairline p-4">
  <div class="relative">
    <div class="layer-back absolute inset-0 translate-x-2 translate-y-2 bg-accent"></div>
    <div class="layer-front relative bg-background overflow-hidden aspect-[16/10]">
      <Image src={cover} alt={`${project.title} cover`} width={800} height={500} loading="lazy" class="h-full w-full object-cover" />
    </div>
  </div>
  <div class="pt-6 space-y-3">
    <h3 class="font-display text-h3">{project.title}</h3>
    <p class="font-display text-body text-text-brown">{project.summary}</p>
    <p class="font-display text-body text-text-brown">{project.description}</p>
    <div class="flex flex-wrap gap-3 pt-1">
      {project.tags.map((t) => (
        <span class="inline-flex items-center rounded-button border border-border-hairline px-3 py-1 font-mono text-body uppercase tracking-widest text-text-muted min-h-[40px]">{t}</span>
      ))}
    </div>
    {project.demoUrl && (
      <iframe
        src={project.demoUrl}
        title={`${project.title} demo`}
        loading="lazy"
        class="mt-3 h-80 w-full border border-border-hairline"
        sandbox="allow-scripts allow-same-origin"
      ></iframe>
    )}
    <span class="font-mono text-label uppercase tracking-widest text-text-muted">{project.status}</span>
  </div>
</article>
