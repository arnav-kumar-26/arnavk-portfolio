---
import type { Project } from '@/types';
import { Image } from 'astro:assets';
import GitHubStats from './GitHubStats.astro';
import miraCover from '../../assets/mira-coach-cover.png';
import fleetCover from '../../assets/fleet-tracker-cover.png';

interface Props {
  project: Project;
}

const { project } = Astro.props as Props;

const coverMap: Record<string, typeof miraCover> = {
  'mira-coach-cover.png': miraCover,
  'fleet-tracker-cover.png': fleetCover,
};

const cover = coverMap[project.coverImage] ?? miraCover;
---

<article class="project-card border border-border-hairline bg-background p-4">
  <div class="relative">
    <div class="layer-back absolute inset-0 translate-x-2 translate-y-2 bg-border-hairline"></div>
    <div class="layer-front relative bg-background">
      <Image src={cover} alt={`${project.title} cover`} width={800} height={450} loading="lazy" class="h-auto w-full object-cover" />
    </div>
  </div>
  <div class="pt-4 space-y-2">
    <h3 class="font-display text-h3">{project.title}</h3>
    <p class="font-display text-body text-text-muted">{project.summary}</p>
    <p class="font-display text-body text-text-muted">{project.description}</p>
    <div class="flex flex-wrap gap-2 pt-1">
      {project.tags.map((t) => <span class="border border-border-hairline px-2 py-1 font-mono text-label uppercase tracking-widest text-text-muted">{t}</span>)}
    </div>
    {project.demoUrl && (
      <iframe
        src={project.demoUrl}
        title={`${project.title} demo`}
        loading="lazy"
        class="mt-3 h-64 w-full border border-border-hairline"
        sandbox="allow-scripts allow-same-origin"
      ></iframe>
    )}
    {project.githubRepo && (
      <GitHubStats name={project.githubRepo.name} owner={project.githubRepo.owner} />
    )}
    <span class="font-mono text-label uppercase tracking-widest text-text-muted">{project.status}</span>
  </div>
</article>
