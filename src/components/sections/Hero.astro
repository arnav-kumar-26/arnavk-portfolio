---
import Button from '../ui/Button.astro';
import { Image } from 'astro:assets';
import heroPortrait from '../../assets/hero-portrait.svg';
---

<section id="hero" aria-labelledby="hero-heading" class="relative flex min-h-[100dvh] flex-col overflow-hidden">
  <div class="flex flex-1 flex-col justify-center gap-8 py-16">
    <h1 id="hero-heading" class="reveal-hero relative z-10 font-display text-hero leading-[0.9] tracking-tightest">Arnav</h1>
    <p class="reveal relative z-10 font-display text-body text-text-muted" style="animation-delay: calc(var(--stagger) * 1); max-width: var(--content-col-max)">
      Developer — building static-first, token-driven interfaces. Currently available for internships in India.
    </p>
  </div>
  <div class="relative z-10 flex items-end justify-between gap-8 pb-10">
    <div class="no-reveal flex flex-wrap gap-3">
      <Button href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</Button>
      <Button href="#contact" variant="outline">Contact</Button>
    </div>
  </div>
  <div class="pointer-events-none absolute top-16 right-0 z-0 hidden -mr-4 sm:block md:top-20 md:-mr-8 lg:-mr-12">
    <Image
      src={heroPortrait}
      alt="Portrait of Arnav"
      width={480}
      height={480}
      loading="eager"
      fetchpriority="high"
      class="h-[calc(100dvh-12rem)] w-auto max-w-[36vw] object-cover"
    />
  </div>
</section>
