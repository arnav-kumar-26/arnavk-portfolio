---
import Button from '../ui/Button.astro';
import { Image } from 'astro:assets';
import heroPortrait from '../../assets/hero-portrait.svg';
---

<section id="hero" aria-labelledby="hero-heading" class="relative flex min-h-[100dvh] flex-col overflow-hidden">
  <div class="flex flex-1 flex-col justify-start gap-12 pt-32 md:pt-40 pb-16">
    <h1 id="hero-heading" class="reveal-hero relative z-10 font-display text-hero leading-[0.9] pl-[8vw]">
      Arnav<span class="relative -top-[0.55em] -ml-2 align-top text-h4 text-text-muted" aria-hidden="true">©</span>
    </h1>
    <div class="hero-content-grid mt-4">
      <div class="hero-label">
        <span class="reveal relative z-10 font-mono text-label uppercase tracking-widest text-text-muted block" style="animation-delay: calc(var(--stagger) * 1)" aria-hidden="true">[Intro]</span>
      </div>
      <div class="hero-body">
        <p class="reveal relative z-10 font-display text-body text-text-brown" style="animation-delay: calc(var(--stagger) * 2); max-width: var(--content-col-max)">
          Developer — building static-first, token-driven interfaces. Currently available for internships in India.
        </p>
      </div>
    </div>
  </div>
  <div class="relative z-10 flex items-end justify-between gap-8 pb-10">
    <span class="font-mono text-label uppercase tracking-widest text-text-primary hidden sm:block">Scroll Down</span>
    <div class="no-reveal flex flex-wrap gap-4 ml-auto">
      <Button href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</Button>
      <Button href="#contact" variant="outline">Contact</Button>
    </div>
  </div>
  <div class="pointer-events-none absolute top-16 right-0 z-0 hidden -mr-4 sm:block md:top-20 md:-mr-8 lg:-mr-12">
    <Image
      src={heroPortrait}
      alt="Portrait of Arnav"
      width={480}
      height={480}
      loading="eager"
      fetchpriority="high"
      class="h-[calc(100dvh-12rem)] w-auto max-w-[36vw] object-cover"
    />
  </div>
</section>

<style>
  .hero-content-grid {
    display: grid;
    grid-template-columns: var(--label-col-width) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 640px) {
    .hero-content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
