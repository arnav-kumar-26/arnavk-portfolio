---
import Button from '../ui/Button.astro';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID as string | undefined;
const hasFormspree = Boolean(formspreeId);
const action = hasFormspree ? `https://formspree.io/f/${formspreeId}` : undefined;
---

<section id="contact" aria-labelledby="contact-heading" class="py-56 md:py-72 min-h-[60vh] contact-warm text-text-inverse w-[100vw] max-w-[100vw] ml-[calc(50%-50vw)] mr-[calc(50%-50vw)] px-4 md:px-8 lg:px-12">
  <div class="mx-auto max-w-7xl grid gap-8 md:grid-cols-2 md:items-start">
    <h2 id="contact-heading" class="reveal font-display text-h2 tracking-tightest text-text-inverse">Let's Connect</h2>

    {hasFormspree ? (
      <form action={action} method="POST" class="space-y-4">
        <div class="space-y-1">
          <label for="contact-name" class="font-mono text-label uppercase tracking-widest text-text-inverse-muted">Name</label>
          <input id="contact-name" name="name" type="text" required autocomplete="name" class="w-full border border-border-hairline-inverse bg-transparent px-3 py-2 font-mono text-body text-text-inverse focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-text-inverse" />
        </div>
        <div class="space-y-1">
          <label for="contact-email" class="font-mono text-label uppercase tracking-widest text-text-inverse-muted">Email</label>
          <input id="contact-email" name="email" type="email" required autocomplete="email" class="w-full border border-border-hairline-inverse bg-transparent px-3 py-2 font-mono text-body text-text-inverse focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-text-inverse" />
        </div>
        <div class="space-y-1">
          <label for="contact-message" class="font-mono text-label uppercase tracking-widest text-text-inverse-muted">Message</label>
          <textarea id="contact-message" name="message" rows={4} required class="w-full border border-border-hairline-inverse bg-transparent px-3 py-2 font-mono text-body text-text-inverse focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-text-inverse"></textarea>
        </div>
        <Button>Send Message</Button>
        <p aria-live="polite" class="font-mono text-body text-text-inverse-muted min-h-[1.5rem]" data-form-status></p>
      </form>
      <script>
        const form = document.querySelector('#contact form') as HTMLFormElement | null;
        const status = document.querySelector('[data-form-status]');
        if (form && status) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = new FormData(form);
            try {
              const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
              if (res.ok) {
                status.textContent = 'Thanks — message sent!';
                form.reset();
              } else {
                status.textContent = 'Something went wrong — please email directly.';
              }
            } catch {
              status.textContent = 'Network error — please email directly.';
            }
          });
        }
      </script>
    ) : (
      <div class="space-y-4">
        <p class="font-display text-body text-text-inverse-muted">Available for internships and collaborations. Reach out directly via email.</p>
        <a href="mailto:hello@example.com" class="link-underline font-mono text-body uppercase tracking-widest text-text-inverse w-fit">Contact ↗</a>
      </div>
    )}
  </div>
</section>

<style>
  /* Interim photographic placeholder (reference has a full-bleed photo here):
     warm wash over the dark base; swap background-image for the photo when available. */
  .contact-warm {
    background-color: theme('colors.background.dark');
    background-image: linear-gradient(120deg, color-mix(in srgb, theme('colors.accent.warm') 45%, transparent), transparent 65%);
  }
</style>
