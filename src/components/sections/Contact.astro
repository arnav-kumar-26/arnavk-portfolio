---
import Button from '../ui/Button.astro';
import ConnectBg from './ConnectBg.astro';
import { getImage } from 'astro:assets';
import bg1 from '../../assets/connect1.png';
import bg2 from '../../assets/connect2.png';
import bg3 from '../../assets/connect3.png';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID as string | undefined;
const hasFormspree = Boolean(formspreeId);
const action = hasFormspree ? `https://formspree.io/f/${formspreeId}` : undefined;

// Optimized at build time; one is picked at random client-side per page load.
const bgPool = await Promise.all(
  [bg1, bg2, bg3].map(async (src) => (await getImage({ src, width: 1600, format: 'webp' })).src)
);
---

<section id="contact" aria-labelledby="contact-heading" class="py-64 md:py-80 lg:py-96 min-h-[85vh] contact-warm text-white w-[100vw] max-w-[100vw] ml-[calc(50%-50vw)] mr-[calc(50%-50vw)] px-6 md:px-12 flex flex-col justify-center" data-connect-pool={JSON.stringify(bgPool)}>
  <ConnectBg />
  <div class="w-full grid gap-12 md:grid-cols-8 md:gap-6 md:items-start">
    <div class="md:col-start-1 md:col-span-4">
      <h2 id="contact-heading" class="reveal font-display text-[clamp(3.5rem,8vw,110px)] font-semibold tracking-[-0.04em] leading-[0.92] text-white p-2">
        Let's Connect
      </h2>
    </div>

    <div class="md:col-start-5 md:col-span-4 space-y-8">
      {hasFormspree ? (
        <form action={action} method="POST" class="reveal-group space-y-6">
          <div class="space-y-2">
            <label for="contact-name" class="font-mono text-xs uppercase tracking-widest text-white/70">Name</label>
            <input id="contact-name" name="name" type="text" required autocomplete="name" class="w-full border border-white/20 bg-transparent px-4 py-3 font-mono text-[23.04px] text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white transition-all duration-350 ease-signature hover:border-white/40 focus:border-white focus:bg-white/5" />
          </div>
          <div class="space-y-2">
            <label for="contact-email" class="font-mono text-xs uppercase tracking-widest text-white/70">Email</label>
            <input id="contact-email" name="email" type="email" required autocomplete="email" class="w-full border border-white/20 bg-transparent px-4 py-3 font-mono text-[23.04px] text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white transition-all duration-350 ease-signature hover:border-white/40 focus:border-white focus:bg-white/5" />
          </div>
          <div class="space-y-2">
            <label for="contact-message" class="font-mono text-xs uppercase tracking-widest text-white/70">Message</label>
            <textarea id="contact-message" name="message" rows={4} required class="w-full border border-white/20 bg-transparent px-4 py-3 font-mono text-[23.04px] text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white transition-all duration-350 ease-signature hover:border-white/40 focus:border-white focus:bg-white/5"></textarea>
          </div>
          <div>
            <Button>Send Message</Button>
          </div>
          <p aria-live="polite" class="font-mono text-[23.04px] text-white/70 min-h-[1.5rem]" data-form-status></p>
        </form>
        <script>
          const form = document.querySelector('#contact form') as HTMLFormElement | null;
          const status = document.querySelector('[data-form-status]');
          if (form && status) {
            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              const data = new FormData(form);
              try {
                const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
                if (res.ok) {
                  status.textContent = 'Thanks — message sent!';
                  form.reset();
                } else {
                  status.textContent = 'Something went wrong — please email directly.';
                }
              } catch {
                status.textContent = 'Network error — please email directly.';
              }
            });
          }
        </script>
      ) : (
        <div class="reveal-group space-y-8">
          <p class="font-display text-[23.04px] leading-[1.6] text-white">
            Available for work and collaborations. Reach out directly via email to explore new ideas or build something remarkable together.
          </p>
          <a href="mailto:arnav.kumar26004@gmail.com" class="link-underline font-mono text-[23.04px] uppercase tracking-widest text-white block w-fit transition-colors duration-350 ease-signature">
            CONTACT ↗
          </a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Photo with a slight uniform dim so white text stays legible. */
  .contact-warm {
    background-color: #12100e;
    background-image: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)), var(--connect-photo, none);
    background-size: auto, cover;
    background-position: center;
  }
</style>

<script>
  const section = document.querySelector('#contact[data-connect-pool]');
  if (section instanceof HTMLElement && section.dataset.connectPool) {
    const pool = JSON.parse(section.dataset.connectPool) as string[];
    section.style.setProperty('--connect-photo', `url("${pool[Math.floor(Math.random() * pool.length)]}")`);
  }
</script>
