---
import { skills } from '../../data/skills';
import SkillPill from './SkillPill.astro';
---

<section id="skills" aria-labelledby="skills-heading" class="pt-section pb-[var(--section-rhythm-lg)]">
  <div class="mb-16">
    <h2 id="skills-heading" class="reveal font-display text-hero tracking-tightest pl-[4vw]">Skills</h2>
  </div>
  <div class="grid gap-x-12 gap-y-10 md:grid-cols-3">
    {skills.map((cat) => (
      <div class="space-y-3">
        <h3 class="font-mono text-body uppercase tracking-widest text-text-primary">{cat.category}</h3>
        <div class="flex flex-wrap gap-3">
          {cat.items.map((item) => <SkillPill label={item} />)}
        </div>
      </div>
    ))}
  </div>
</section>
