---
import { skills } from '../../data/skills';
import SkillPill from './SkillPill.astro';
import Eyebrow from '../ui/Eyebrow.astro';
---

<section id="skills" aria-labelledby="skills-heading" class="py-section border-t border-border-hairline">
  <div class="mb-8 flex items-baseline gap-4">
    <Eyebrow label="SKILLS" />
    <h2 id="skills-heading" class="reveal font-display text-h2 tracking-tightest">Skills</h2>
  </div>
  <div class="space-y-6">
    {skills.map((cat) => (
      <div class="space-y-2">
        <h3 class="font-mono text-label uppercase tracking-widest text-text-muted">{cat.category}</h3>
        <div class="flex flex-wrap gap-2">
          {cat.items.map((item) => <SkillPill label={item} />)}
        </div>
      </div>
    ))}
  </div>
</section>
