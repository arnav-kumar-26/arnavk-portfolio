---
import { experience } from '../../data/experience';
import ExperienceRow from './ExperienceRow.astro';

const sorted = [...experience].sort((a, b) => b.startDate.localeCompare(a.startDate));
---

<section id="experience" aria-labelledby="experience-heading" class="py-32 md:py-48">
  <div class="mb-20 md:mb-28">
    <h2 id="experience-heading" class="reveal font-display font-semibold text-[clamp(3.5rem,11.5vw,179.194px)] tracking-[-0.04em] leading-[0.88] text-text-primary p-2">
      Experience
    </h2>
  </div>
  <div class="reveal-group">
    {sorted.map((e) => <ExperienceRow entry={e} />)}
  </div>
</section>
