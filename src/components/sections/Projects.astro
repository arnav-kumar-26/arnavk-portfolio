---
import { projects } from '../../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" aria-labelledby="projects-heading" class="py-32 md:py-40">
  <div class="mb-20 md:mb-28">
    <h2 id="projects-heading" class="reveal font-display font-semibold text-[clamp(3.5rem,11.5vw,179.194px)] tracking-[-0.04em] leading-[0.88] text-text-primary p-2">
      Selected Works
    </h2>
  </div>
  <div class="reveal-group grid gap-6 lg:grid-cols-2">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</section>
