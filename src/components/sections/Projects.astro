---
import { projects } from '../../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" aria-labelledby="projects-heading" class="py-section">
  <div class="mb-16">
    <h2 id="projects-heading" class="font-display text-h2 tracking-tightest">Selected Works</h2>
  </div>
  <div class="reveal-group grid gap-6 md:grid-cols-2">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</section>
