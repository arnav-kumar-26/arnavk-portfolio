---
interface Props {
  label: string;
}

const { label } = Astro.props as Props;
---

<span class="skill-pill inline-flex items-center rounded-button border border-border-hairline px-4 py-2 font-mono text-[23.04px] uppercase tracking-wider text-text-primary bg-background transition-all duration-350 ease-signature hover:border-text-primary hover:bg-neutral-100/60 hover:translate-y-[-2px] cursor-default">
  {label}
</span>
