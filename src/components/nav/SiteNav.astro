---
import NavLink from './NavLink.astro';

interface NavItem {
  label: string;
  href: string;
}

const defaultNav: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Experience', href: '#experience' },
  { label: 'Works', href: '#projects' },
  { label: 'Writing', href: '/coming-soon' },
];

const { items = defaultNav } = Astro.props as { items?: NavItem[] };
---

<nav class="site-nav sticky top-0 z-40 flex w-full items-center justify-between bg-transparent px-4 py-4 border-b border-transparent transition-colors duration-350 ease-signature md:px-12" aria-label="Primary">
  <a href="/" class="font-mono text-nav uppercase tracking-widest text-text-primary focus-visible:outline-none">
    ARNAV
  </a>
  <div class="flex min-w-0 flex-nowrap items-center justify-end gap-4 whitespace-nowrap md:gap-6">
    {
      items.map((item, i) => (
        <>
          <NavLink label={item.label} href={item.href} />
          {i < items.length - 1 && <span class="font-mono text-label text-text-muted" aria-hidden="true">/</span>}
        </>
      ))
    }
  </div>
</nav>

<script>
  import '../../scripts/sticky-nav.ts';
</script>

<style>
  .site-nav.is-scrolled {
    background: theme('colors.background.nav');
    border-bottom-color: theme('colors.border.hairline');
  }
</style>
