---
const year = new Date().getFullYear();
---

<footer class="relative bg-background-dark text-text-inverse overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 py-12 md:px-8 md:py-16">
    <!-- Rotated name-mark: flex justify-end + rotate(180deg) in normal flow (never absolute) -->
    <div class="footer-namemark-row flex justify-end overflow-hidden">
      <span class="footer-namemark inline-block rotate-180 font-namemark font-black tracking-tightest leading-[0.9] text-white whitespace-nowrap" aria-hidden="true">
        arnav k.
      </span>
    </div>

    <div class="mt-8 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <div class="flex flex-col gap-2 max-w-[16rem]">
        <p class="font-mono text-label uppercase tracking-widest text-text-inverse-muted">Let's Connect</p>
        <a href="mailto:hello@example.com" class="link-underline font-mono text-body text-text-inverse w-fit">hello@example.com</a>
        <p class="font-mono text-body text-text-inverse-muted">Based in India — available for internships.</p>
      </div>
      <div class="flex flex-col gap-2 text-right md:text-left">
        <nav aria-label="Social links" class="flex gap-4 justify-end md:justify-start">
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="link-underline font-mono text-label uppercase tracking-widest text-text-inverse-muted hover:text-text-inverse">GitHub</a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="link-underline font-mono text-label uppercase tracking-widest text-text-inverse-muted hover:text-text-inverse">LinkedIn</a>
          <a href="mailto:hello@example.com" class="link-underline font-mono text-label uppercase tracking-widest text-text-inverse-muted hover:text-text-inverse">Email</a>
        </nav>
        <p class="font-mono text-label text-text-inverse-muted">© {year} Arnav. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-namemark {
    transform: rotate(180deg);
    font-size: clamp(4rem, 16vw, 9rem);
    letter-spacing: -0.02em;
    line-height: 0.9;
    color: #ffffff;
    white-space: nowrap;
  }
  .footer-namemark-row {
    display: flex;
    justify-content: flex-end;
    overflow: hidden;
  }
</style>
