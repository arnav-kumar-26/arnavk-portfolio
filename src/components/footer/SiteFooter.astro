---
import { socialLinks } from '../../data/social';

const year = new Date().getFullYear();
const socials = socialLinks.filter((s) => s.platform !== 'Email');
const email = socialLinks.find((s) => s.platform === 'Email');
---

<footer class="relative bg-background-dark text-text-inverse overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 pt-40 pb-8 md:px-8">
    <!-- Rotated name-mark: flex justify-end + rotate(180deg) in normal flow (never absolute) -->
    <div class="footer-namemark-row flex justify-end overflow-hidden -mt-40">
      <span class="footer-namemark inline-block rotate-180 font-namemark font-black tracking-tightest leading-[0.9] text-text-inverse whitespace-nowrap" aria-hidden="true">
        arnav.
      </span>
    </div>

    <div class="mt-8 grid gap-8 md:grid-cols-2 md:items-end">
      <div class="space-y-4">
        <div class="flex gap-4">
          <span class="font-mono text-body uppercase tracking-widest text-text-inverse-muted w-32 shrink-0">[Social]</span>
          <nav aria-label="Social links" class="flex flex-col gap-2">
            {socials.map((s) => (
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" class="link-underline font-mono text-body uppercase tracking-widest text-text-inverse-muted hover:text-text-inverse w-fit">{s.platform}</a>
            ))}
          </nav>
        </div>
        {email && (
          <div class="flex gap-4">
            <span class="font-mono text-body uppercase tracking-widest text-text-inverse-muted w-32 shrink-0">[Contact]</span>
            <a href={email.href} aria-label={email.label} class="link-underline font-mono text-body uppercase tracking-widest text-text-inverse-muted hover:text-text-inverse w-fit">{email.href.replace('mailto:', '')}</a>
          </div>
        )}
      </div>
      <div class="flex flex-col gap-2 md:items-end md:text-right">
        <p class="font-mono text-body text-text-inverse">Based in Bangalore, India — available for work.</p>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap items-end justify-between gap-4">
      <p class="font-mono text-body text-text-inverse-muted">12.92646° N, 77.67812° E</p>
      <p class="font-mono text-body text-text-inverse-muted">© {year} Arnav. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer-namemark {
    transform: rotate(180deg);
    font-size: clamp(8rem, 22vw, 14rem);
    letter-spacing: -0.02em;
    line-height: 0.9;
    color: theme('colors.text.inverse');
    white-space: nowrap;
  }
  .footer-namemark-row {
    display: flex;
    justify-content: flex-end;
    overflow: hidden;
  }
</style>