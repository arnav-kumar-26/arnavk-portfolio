---
import { socialLinks } from '../../data/social';

const year = new Date().getFullYear();
const socials = socialLinks.filter((s) => s.platform !== 'Email');
const email = socialLinks.find((s) => s.platform === 'Email');
---

<footer class="relative bg-background-dark text-text-inverse overflow-hidden h-[600px] min-h-[600px] max-h-[600px]">
  <div class="w-full h-full px-6 md:px-12 flex flex-col justify-between pt-0 pb-0">
    <!-- Rotated name-mark: top offset 0px from top of section, padding: 0px, flex justify-end in normal flow -->
    <div class="footer-namemark-row flex items-start justify-end overflow-hidden pt-0 mt-0 text-left" style="margin-top: 0px; padding-top: 0px;">
      <span class="footer-namemark inline-block rotate-180 font-namemark font-black tracking-tightest leading-[0.85] text-text-inverse whitespace-nowrap text-left p-0 m-0" aria-hidden="true" style="padding: 0px; margin-top: 0px;">
        arnav.
      </span>
    </div>

    <!-- Middle social & contact links -->
    <div class="reveal grid gap-8 md:grid-cols-2 md:items-end pt-0 pb-8" style="animation-delay: calc(var(--stagger) * 1)">
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-4 sm:gap-6">
          <span class="font-mono text-[23.04px] uppercase tracking-widest text-text-inverse-muted shrink-0 w-36">[Social]</span>
          <nav aria-label="Social links" class="flex flex-col gap-2">
            {socials.map((s) => (
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" class="link-underline font-mono text-[23.04px] uppercase tracking-widest text-text-inverse-muted hover:text-text-inverse transition-colors duration-350 ease-signature w-fit">{s.platform}</a>
            ))}
          </nav>
        </div>
        {email && (
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-4 sm:gap-6">
            <span class="font-mono text-[23.04px] uppercase tracking-widest text-text-inverse-muted shrink-0 w-36">[Contact]</span>
            <a href={email.href} aria-label={email.label} class="link-underline font-mono text-[23.04px] uppercase tracking-widest text-text-inverse-muted hover:text-text-inverse transition-colors duration-350 ease-signature w-fit">{email.href.replace('mailto:', '')}</a>
          </div>
        )}
      </div>
      <div class="flex flex-col gap-2 md:items-end md:text-right">
        <p class="font-mono text-[23.04px] text-text-inverse leading-relaxed">Based in Bellandur, Bangalore, India — available for work.</p>
      </div>
    </div>

    <!-- Bottom bar & divider: border line 32px above text, text 32px from section bottom -->
    <div class="reveal border-t border-white/10 pt-[32px] pb-[32px] flex flex-wrap items-end justify-between gap-6" style="animation-delay: calc(var(--stagger) * 2)">
      <p class="font-mono text-[23.04px] text-text-inverse-muted m-0 p-0">12.92646° N, 77.67812° E</p>
      <p class="font-mono text-[23.04px] text-text-inverse-muted m-0 p-0">© {year} Arnav. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer-namemark {
    transform: rotate(180deg);
    font-size: clamp(12rem, 32vw, 24rem);
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: theme('colors.text.inverse');
    white-space: nowrap;
    text-align: left;
    padding: 0px;
    margin-top: 0px;
  }
  .footer-namemark-row {
    display: flex;
    justify-content: flex-end;
    overflow: hidden;
    text-align: left;
    margin-top: 0px;
    padding-top: 0px;
  }
</style>