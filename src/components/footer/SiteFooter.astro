---
import { socialLinks } from '../../data/social';

const year = new Date().getFullYear();
const socials = socialLinks.filter((s) => s.platform !== 'Email');
const email = socialLinks.find((s) => s.platform === 'Email');
---

<footer class="relative bg-background-dark text-text-inverse overflow-hidden">
  <div class="w-full px-6 pt-24 pb-16 md:px-12">
    <!-- Rotated name-mark: flex justify-end pr-0 (bounded by container's 48px padding), text-left, rotate(180deg) in normal flow -->
    <div class="footer-namemark-row flex items-start justify-end overflow-hidden -mt-8 md:-mt-16 text-left">
      <span class="footer-namemark inline-block rotate-180 font-namemark font-black tracking-tightest leading-[0.85] text-text-inverse whitespace-nowrap text-left" aria-hidden="true">
        arnav.
      </span>
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-2 md:items-end">
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-4 sm:gap-6">
          <span class="font-mono text-[23.04px] uppercase tracking-widest text-text-inverse-muted shrink-0 w-36">[Social]</span>
          <nav aria-label="Social links" class="flex flex-col gap-2.5">
            {socials.map((s) => (
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" class="link-underline font-mono text-[23.04px] uppercase tracking-widest text-text-inverse-muted hover:text-text-inverse w-fit">{s.platform}</a>
            ))}
          </nav>
        </div>
        {email && (
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-4 sm:gap-6">
            <span class="font-mono text-[23.04px] uppercase tracking-widest text-text-inverse-muted shrink-0 w-36">[Contact]</span>
            <a href={email.href} aria-label={email.label} class="link-underline font-mono text-[23.04px] uppercase tracking-widest text-text-inverse-muted hover:text-text-inverse w-fit">{email.href.replace('mailto:', '')}</a>
          </div>
        )}
      </div>
      <div class="flex flex-col gap-2 md:items-end md:text-right">
        <p class="font-mono text-[23.04px] text-text-inverse leading-relaxed">Based in Bangalore, India — available for work.</p>
      </div>
    </div>

    <div class="mt-16 flex flex-wrap items-end justify-between gap-6 border-t border-white/10 pt-8">
      <p class="font-mono text-[23.04px] text-text-inverse-muted">12.92646° N, 77.67812° E</p>
      <p class="font-mono text-[23.04px] text-text-inverse-muted">© {year} Arnav. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer-namemark {
    transform: rotate(180deg);
    font-size: clamp(12rem, 32vw, 24rem);
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: theme('colors.text.inverse');
    white-space: nowrap;
    text-align: left;
  }
  .footer-namemark-row {
    display: flex;
    justify-content: flex-end;
    overflow: hidden;
    text-align: left;
  }
</style>