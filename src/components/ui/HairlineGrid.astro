<!--
  Must be rendered as the first child inside <main> (before <slot />), not as a
  top-level sibling of <main>. Its position:absolute + -z-10 only shows through
  because it then shares main's own stacking context: a stacking context always
  paints its own background first, then its negative-z-index children, then its
  normal-flow content on top. Placed outside <main> (as a fixed sibling) it sits
  *behind* main's opaque background and is fully hidden by it.
-->
<div aria-hidden="true" class="hairline-grid pointer-events-none fixed inset-0 -z-10 w-full px-[48px]">
  <div class="grid h-full w-full grid-cols-8 gap-[24px]">
    <div class="h-full border-l border-r border-border-hairline"></div>
    <div class="h-full border-l border-r border-border-hairline"></div>
    <div class="h-full border-l border-r border-border-hairline"></div>
    <div class="h-full border-l border-r border-border-hairline"></div>
    <div class="h-full border-l border-r border-border-hairline"></div>
    <div class="h-full border-l border-r border-border-hairline"></div>
    <div class="h-full border-l border-r border-border-hairline"></div>
    <div class="h-full border-l border-r border-border-hairline"></div>
  </div>
</div>

<style>
  .border-border-hairline {
    border-color: rgba(0, 0, 0, 0.09);
  }
</style>