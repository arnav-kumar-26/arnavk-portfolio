<!--
  Must be rendered as the first child inside <main> (before <slot />), not as a
  top-level sibling of <main>. Its position:absolute + -z-10 only shows through
  because it then shares main's own stacking context: a stacking context always
  paints its own background first, then its negative-z-index children, then its
  normal-flow content on top. Placed outside <main> (as a fixed sibling) it sits
  *behind* main's opaque background and is fully hidden by it.
-->
<div aria-hidden="true" class="hairline-grid pointer-events-none absolute inset-0 -z-10"></div>

<style>
  .hairline-grid {
    background-image: repeating-linear-gradient(
      to right,
      transparent 0,
      transparent calc((100% - var(--gutter-width) * 2) / var(--grid-columns) - 1px),
      color-mix(in srgb, theme('colors.border.hairline') 10%, transparent) calc((100% - var(--gutter-width) * 2) / var(--grid-columns) - 1px),
      transparent calc((100% - var(--gutter-width) * 2) / var(--grid-columns))
    );
    background-position: var(--gutter-width) 0;
    background-repeat: repeat;
    background-size: calc((100% - var(--gutter-width) * 2) / var(--grid-columns)) 100%;
  }
</style>