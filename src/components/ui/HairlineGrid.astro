<div aria-hidden="true" class="hairline-grid pointer-events-none fixed inset-0 -z-10"></div>

<style>
  .hairline-grid {
    background-image: repeating-linear-gradient(
      to right,
      transparent 0,
      transparent calc((100% - var(--gutter-width) * 2) / var(--grid-columns) - 1px),
      theme('colors.border.hairline') calc((100% - var(--gutter-width) * 2) / var(--grid-columns) - 1px),
      transparent calc((100% - var(--gutter-width) * 2) / var(--grid-columns))
    );
    background-position: var(--gutter-width) 0;
    background-repeat: repeat;
    background-size: calc((100% - var(--gutter-width) * 2) / var(--grid-columns)) 100%;
    opacity: 0.6;
  }
</style>
