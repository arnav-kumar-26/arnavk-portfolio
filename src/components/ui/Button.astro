---
interface Props {
  href?: string;
  target?: string;
  rel?: string;
  variant?: 'primary' | 'outline';
  ariaLabel?: string;
  typography?: string;
}

const { href, target, rel, variant = 'primary', ariaLabel, typography = 'font-mono text-body uppercase tracking-widest' } = Astro.props;

const base = `inline-flex items-center gap-2 rounded-button ${typography} px-6 py-3 transition-colors duration-350 ease-signature focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2`;
const variants = {
  primary: 'bg-accent text-text-inverse hover:bg-accent-hover border border-transparent',
  outline: 'bg-transparent text-text-primary border border-text-primary hover:bg-accent hover:text-text-inverse hover:border-accent',
};
const classes = `${base} ${variants[variant]}`;
---

{
  href ? (
    <a href={href} target={target} rel={rel} aria-label={ariaLabel} class={classes}>
      <slot />
      <span class="arrow-swap" aria-hidden="true">
        <span class="arrow arrow--out">↗</span>
        <span class="arrow arrow--in">↗</span>
      </span>
    </a>
  ) : (
    <button aria-label={ariaLabel} class={classes}>
      <slot />
      <span class="arrow-swap" aria-hidden="true">
        <span class="arrow arrow--out">↗</span>
        <span class="arrow arrow--in">↗</span>
      </span>
    </button>
  )
}
