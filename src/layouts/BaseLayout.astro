---
import '../styles/global.css';
import HairlineGrid from '../components/ui/HairlineGrid.astro';
import SiteNav from '../components/nav/SiteNav.astro';
import SiteFooter from '../components/footer/SiteFooter.astro';
import SEO from '../components/seo/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title = 'Portfolio — Arnav', description = 'Portfolio of Arnav — projects, experience, and writing.', ogImage, canonical: canonicalProp, noindex } = Astro.props;
const canonical = canonicalProp ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Preload above-the-fold fonts (Geist 500/600 + PT Mono 400); footer namemark is below-fold and not preloaded per §1.3 -->
    <link rel="preload" href="/fonts/geist-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pt-mono-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-background text-text-primary antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-background focus:px-4 focus:py-2 focus:font-mono focus:text-label focus:uppercase">Skip to content</a>
    <SiteNav />
    <main id="main-content" class="relative z-10 bg-background px-[var(--gutter-width)]">
      <HairlineGrid />
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/entrance.ts';
    </script>
    <span class="site-cursor rounded-pill" aria-hidden="true"></span>
    <script>
      // Enhanced custom cursor:
      // Fine-pointer only, inert under prefers-reduced-motion.
      // Immediate mouse tracking via left/top (0 latency).
      // Smooth scale & border-width expansion on interactive elements.
      // Seamless contrast adaptation via mix-blend-mode: difference.
      const dot = document.querySelector<HTMLElement>('.site-cursor');
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (dot && finePointer && !reducedMotion) {
        let isHovered = false;

        document.addEventListener(
          'mousemove',
          (e) => {
            dot.style.opacity = '1';
            dot.style.left = `${e.clientX}px`;
            dot.style.top = `${e.clientY}px`;

            const target = e.target as HTMLElement | null;
            const interactive = target
              ? target.closest('a, button, [role="button"], input, textarea, select, label, .project-card, .skill-pill, [data-interactive]')
              : null;

            if (interactive && !isHovered) {
              isHovered = true;
              dot.classList.add('cursor-hover');
            } else if (!interactive && isHovered) {
              isHovered = false;
              dot.classList.remove('cursor-hover');
            }
          },
          { passive: true }
        );

        document.addEventListener('mouseleave', () => {
          dot.style.opacity = '0';
          isHovered = false;
          dot.classList.remove('cursor-hover');
        });
      }
    </script>
  </body>
</html>

<style>
  /* Fluid container constraints — prevents CLS on hydration */
  main {
    min-height: 50vh;
  }

  /* Enhanced site-wide cursor-circle */
  .site-cursor {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 2.5px solid #ffffff;
    background-color: transparent;
    mix-blend-mode: difference;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    box-shadow: inset 0 0 0 0px #ffffff;
    transition: opacity var(--dur-fast) var(--ease-signature),
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site-cursor.cursor-hover {
    box-shadow: inset 0 0 0 4px #ffffff;
  }
  @media (pointer: fine) {
    body,
    body a,
    body button,
    body input,
    body select,
    body textarea,
    body label,
    body [role="button"],
    body .project-card,
    body .skill-pill,
    body [data-interactive] {
      cursor: none;
    }
    body .site-cursor {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    body,
    body a,
    body button,
    body input,
    body select,
    body textarea,
    body label,
    body [role="button"] {
      cursor: auto;
    }
    body .site-cursor {
      display: none;
    }
  }
</style>