---
import '../styles/global.css';
import HairlineGrid from '../components/ui/HairlineGrid.astro';
import SiteNav from '../components/nav/SiteNav.astro';
import SiteFooter from '../components/footer/SiteFooter.astro';
import SEO from '../components/seo/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title = 'Portfolio — Arnav', description = 'Portfolio of Arnav — projects, experience, and writing.', ogImage, canonical: canonicalProp, noindex } = Astro.props;
const canonical = canonicalProp ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Preload above-the-fold fonts (Geist 500/600 + PT Mono 400); footer namemark is below-fold and not preloaded per §1.3 -->
    <link rel="preload" href="/fonts/geist-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pt-mono-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-background text-text-primary antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-background focus:px-4 focus:py-2 focus:font-mono focus:text-label focus:uppercase">Skip to content</a>
    <SiteNav />
    <main id="main-content" class="relative z-10 bg-background px-[var(--gutter-width)]">
      <HairlineGrid />
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/entrance.ts';
    </script>
    <span class="site-cursor rounded-pill" aria-hidden="true"></span>
    <script>
      // Site-wide custom cursor-circle (moved from Hero-scoped per TASK.md Task 5):
      // single dot + document-level mousemove listener, fine-pointer only,
      // inert under prefers-reduced-motion.
      const dot = document.querySelector('.site-cursor');
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (dot instanceof HTMLElement && finePointer && !reducedMotion) {
        document.addEventListener(
          'mousemove',
          (e) => {
            dot.style.opacity = '1';
            dot.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
            
            const target = document.elementFromPoint(e.clientX, e.clientY);
            if (target && (target.closest('#contact') || target.closest('footer') || target.closest('.bg-background-dark') || target.closest('.contact-warm'))) {
              dot.classList.add('cursor-inverted');
            } else {
              dot.classList.remove('cursor-inverted');
            }
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>

<style>
  /* Fluid container constraints — prevents CLS on hydration */
  main {
    min-height: 50vh;
  }

  /* Site-wide cursor-circle (see script above) */
  .site-cursor {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 2rem;
    height: 2rem;
    margin: -1rem 0 0 -1rem;
    border: 1px solid #1e1e1f;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-signature), border-color var(--dur-fast) var(--ease-signature);
  }
  .site-cursor.cursor-inverted {
    border-color: #ffffff !important;
  }
  @media (pointer: fine) {
    body {
      cursor: none;
    }
    body .site-cursor {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    body {
      cursor: auto;
    }
    body .site-cursor {
      display: none;
    }
  }
</style>