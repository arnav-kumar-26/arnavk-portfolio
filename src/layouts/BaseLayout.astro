---
import '../styles/global.css';
import HairlineGrid from '../components/ui/HairlineGrid.astro';
import SiteNav from '../components/nav/SiteNav.astro';
import SiteFooter from '../components/footer/SiteFooter.astro';
import SEO from '../components/seo/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title = 'Portfolio — Arnav', description = 'Portfolio of Arnav — projects, experience, and writing.', ogImage, canonical: canonicalProp, noindex } = Astro.props;
const canonical = canonicalProp ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Preload above-the-fold fonts (Geist 500/600 + PT Mono 400); footer namemark is below-fold and not preloaded per §1.3 -->
    <link rel="preload" href="/fonts/geist-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pt-mono-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-background text-text-primary antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-background focus:px-4 focus:py-2 focus:font-mono focus:text-label focus:uppercase">Skip to content</a>
    <HairlineGrid />
    <SiteNav />
    <main id="main-content" class="mx-auto max-w-7xl px-4 md:px-8 lg:px-12">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/entrance.ts';
    </script>
  </body>
</html>

<style>
  /* Fluid container constraints — prevents CLS on hydration */
  main {
    min-height: 50vh;
  }
</style>
